<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <AssemblyName>时迹Web</AssemblyName>
    <RootNamespace>UsageTrackerWeb</RootNamespace>
    <Product>时迹Web</Product>
    <Title>时迹Web</Title>
    <Description>时迹 只读网页看板（复用桌面版数据）</Description>
    <Version>3.3.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <!-- 前端由 vite 构建到 web/dist，再同步到 wwwroot -->
    <EnableDefaultContentItems>true</EnableDefaultContentItems>
  </PropertyGroup>

  <!-- 本地 DLL 引用，与桌面版共用同一套 SQLite 驱动 -->
  <ItemGroup>
    <Reference Include="Microsoft.Data.Sqlite">
      <HintPath>..\..\UsageTrackerNativeV2\lib\Microsoft.Data.Sqlite.dll</HintPath>
    </Reference>
    <Reference Include="SQLitePCLRaw.batteries_v2">
      <HintPath>..\..\UsageTrackerNativeV2\lib\SQLitePCLRaw.batteries_v2.dll</HintPath>
    </Reference>
    <Reference Include="SQLitePCLRaw.core">
      <HintPath>..\..\UsageTrackerNativeV2\lib\SQLitePCLRaw.core.dll</HintPath>
    </Reference>
    <Reference Include="SQLitePCLRaw.provider.e_sqlite3">
      <HintPath>..\..\UsageTrackerNativeV2\lib\SQLitePCLRaw.provider.e_sqlite3.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\UsageTrackerNativeV2\lib\native\win-x64\e_sqlite3.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>e_sqlite3.dll</Link>
    </Content>
    <Content Include="Assets\app-icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- 复用桌面版的纯逻辑：凌晨 4 点日界线 + 时长裁剪，保证统计口径一致 -->
  <ItemGroup>
    <Compile Include="..\..\UsageTrackerNativeV2\src\UsageTrackerNative\UsageTimeRange.cs">
      <Link>Shared\UsageTimeRange.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
